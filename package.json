{
  "name": "ajaia-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && next build",
    "start": "node ./scripts/azure-start.cjs",
    "start:local": "next start --port 3001",
    "lint": "eslint",
    "test": "vitest run",
    "db:push": "prisma db push",
